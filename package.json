{
  "private": true,
  "name": "vibeflow",
  "description": "意圖驅動的本地開發看板 — 本機 Web UI / TUI + Claude Code CLI + Git Worktree",
  "version": "4.0.5",
  "author": "KW-Yeh",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:renderer:webpack": "cd renderer && NODE_ENV=production npx next build --webpack",
    "check:node-pty": "node scripts/check-node-pty.mjs",
    "test": "node scripts/run-tests.mjs",
    "vibeflow": "node --experimental-strip-types --import ./test/support/register.mjs scripts/vibeflow.mjs",
    "postinstall": "node scripts/check-node-pty.mjs",
    "start": "node scripts/start.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:npm": "node scripts/build-npm.mjs",
    "test:e2e": "node scripts/run-tests.mjs ./e2e/web.e2e.mjs",
    "doctor": "node --experimental-strip-types --import ./test/support/register.mjs scripts/vibeflow.mjs doctor"
  },
  "dependencies": {
    "motion": "^12.42.2",
    "node-pty": "^1.1.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.11.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^12.0.0",
    "next": "^16.2.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.8",
    "react": "^19.2.7",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.2.4",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
